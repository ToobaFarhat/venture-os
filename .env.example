# ==============================================================================
# VentureOS Environment Configuration Example
# Copy this file to .env in your root or server/ directory and fill in actual values.
# See docs/ENVIRONMENT_VARIABLES.md for the complete variable catalog and details.
# ==============================================================================

# Server Network & Host
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB local or Atlas cluster)
MONGODB_URI=mongodb://127.0.0.1:27017/ventureos

# Authentication & Session Security (Minimum 32 random characters in production)
JWT_SECRET=ventureos_super_secure_jwt_secret_dev_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# AI Provider Configuration ('gemini' | 'openai' | 'anthropic' | 'mock')
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# AI Guardrails & Rate Limits
MAX_TOKENS_PER_REQUEST=4096
AI_RATE_LIMIT_PER_MINUTE=60

# File Upload Storage (Knowledge Base RAG Documents)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=15

# Optional Background Queue / Caching (BullMQ)
REDIS_URL=
